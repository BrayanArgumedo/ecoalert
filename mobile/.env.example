# ─────────────────────────────────────────────────────────
# Reemplaza 192.168.x.x con la IP de tu máquina en la red local
# Ejemplo: 192.168.1.100
#
# Cómo encontrar tu IP:
#   Linux/Mac: ip route get 1.1.1.1 | grep -oP 'src \K\S+'
#   Windows:   ipconfig → busca "Dirección IPv4"
# ─────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api/v1
LOCAL_IP=192.168.x.x
