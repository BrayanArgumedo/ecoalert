meta {
  name: Change Password
  type: http
  seq: 10
}

patch {
  url: {{base_url}}/users/{{user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "contrasena": "NuevaContrasena123!",
    "contrasena_actual": "Admin123!"
  }
}

docs {
  Cambia la contraseña del usuario autenticado.
  - contrasena_actual: obligatorio — se valida contra el hash en la BD
  - contrasena:        obligatorio — nueva contraseña (mínimo 6 caracteres)
  Si la contraseña actual es incorrecta, responde 400.
}
